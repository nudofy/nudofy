{
  "expo": {
    "name": "Nudofy",
    "slug": "nudofy",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E73121"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nudofy.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Necesitamos acceso a tu galería para subir el logo del proveedor."
      },
      "buildNumber": "69"
  },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E73121"
      },
      "package": "com.nudofy.app",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#E73121"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single-page-application"
    },
    "platforms": ["ios", "android", "web"],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-document-picker",
      ["expo-camera", { "cameraPermission": "Necesitamos acceso a la cámara para escanear códigos de barras." }],
      ["expo-image-picker", { "photosPermission": "Necesitamos acceso a tu galería para subir imágenes de productos.", "cameraPermission": "Necesitamos acceso a la cámara para hacer fotos de productos." }],
      ["expo-build-properties", { "android": { "targetSdkVersion": 35, "compileSdkVersion": 35, "useLegacyPackaging": false } }],
      ["@sentry/react-native/expo", {
        "organization": "nudofy",
        "project": "nudofy-app"
      }]
    ],
    "scheme": "nudofy",
    "extra": {
      "eas": { "projectId": "40847a34-c16b-4316-a2a2-a25eb2dcafef" },
      "router": { "origin": false }
    },
    "owner": "nudofy"
  }
}
